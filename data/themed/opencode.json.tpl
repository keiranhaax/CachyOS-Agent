{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": "{{ accent }}",
    "secondary": "{{ blue }}",
    "accent": "{{ cyan }}",
    "error": "{{ red }}",
    "warning": "{{ yellow }}",
    "success": "{{ green }}",
    "info": "{{ cyan }}",
    "text": "{{ foreground }}",
    "textMuted": "{{ muted }}",
    "background": "{{ background }}",
    "backgroundPanel": "{{ mix background foreground 6% }}",
    "backgroundElement": "{{ mix background foreground 10% }}",
    "border": "{{ mix background foreground 30% }}",
    "borderActive": "{{ accent }}",
    "borderSubtle": "{{ mix background foreground 20% }}",
    "diffAdded": "{{ green }}",
    "diffRemoved": "{{ red }}",
    "diffContext": "{{ muted }}",
    "diffHunkHeader": "{{ cyan }}",
    "diffHighlightAdded": "{{ bright_green }}",
    "diffHighlightRemoved": "{{ bright_red }}",
    "diffAddedBg": "{{ mix background green 15% }}",
    "diffRemovedBg": "{{ mix background red 15% }}",
    "diffContextBg": "{{ mix background foreground 6% }}",
    "diffLineNumber": "{{ muted }}",
    "diffAddedLineNumberBg": "{{ mix background green 25% }}",
    "diffRemovedLineNumberBg": "{{ mix background red 25% }}",
    "markdownText": "{{ foreground }}",
    "markdownHeading": "{{ magenta }}",
    "markdownLink": "{{ accent }}",
    "markdownLinkText": "{{ cyan }}",
    "markdownCode": "{{ green }}",
    "markdownBlockQuote": "{{ muted }}",
    "markdownEmph": "{{ yellow }}",
    "markdownStrong": "{{ bright_yellow }}",
    "markdownHorizontalRule": "{{ mix background foreground 20% }}",
    "markdownListItem": "{{ accent }}",
    "markdownListEnumeration": "{{ cyan }}",
    "markdownImage": "{{ accent }}",
    "markdownImageText": "{{ cyan }}",
    "markdownCodeBlock": "{{ foreground }}",
    "syntaxComment": "{{ muted }}",
    "syntaxKeyword": "{{ magenta }}",
    "syntaxFunction": "{{ blue }}",
    "syntaxVariable": "{{ accent }}",
    "syntaxString": "{{ green }}",
    "syntaxNumber": "{{ yellow }}",
    "syntaxType": "{{ cyan }}",
    "syntaxOperator": "{{ magenta }}",
    "syntaxPunctuation": "{{ muted }}"
  }
}
