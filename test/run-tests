#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# Run every test/cases/*.sh in order, each in its own bash process, and report
# per case. A failing case does not stop the others, so there is no set -e.
set -uo pipefail
shopt -s nullglob

cases_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/cases
passed=0
failed=()

for case_file in "$cases_dir"/*.sh; do
  name=${case_file##*/}
  name=${name%.sh}
  printf '== %s\n' "$name"
  if bash "$case_file"; then
    passed=$((passed + 1))
    printf 'PASS %s\n' "$name"
  else
    failed+=("$name")
    printf 'FAIL %s\n' "$name"
  fi
done

if ((passed + ${#failed[@]} == 0)); then
  echo "no test cases found in $cases_dir" >&2
  exit 1
fi
printf '\n%d case(s) passed, %d failed\n' "$passed" "${#failed[@]}"
if ((${#failed[@]} > 0)); then
  printf 'failed: %s\n' "${failed[*]}" >&2
  exit 1
fi
