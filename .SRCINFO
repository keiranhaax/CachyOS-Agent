pkgbase = cachyos-agent
	pkgdesc = CachyOS agent runtime and skills for AI coding agents
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/keiranhaax/CachyOS-Agent
	install = cachyos-agent.install
	arch = any
	license = GPL-3.0-only
	makedepends = git
	depends = bash
	depends = jq
	depends = python
	depends = coreutils
	depends = gawk
	depends = systemd
	optdepends = libnotify>=0.8.8: desktop notifications for crash capture, usage limits and account switching
	optdepends = konsole: terminal for launched agents
	optdepends = alacritty: terminal for launched agents
	optdepends = kconfig: Plasma global shortcut and theme sync helpers
	optdepends = plasma-desktop: agents panel widget
	optdepends = qt6-tools: paste a prompt through Klipper when the agent has no prompt flag
	optdepends = wl-clipboard: paste a prompt through the Wayland clipboard when Klipper is absent
	optdepends = xdg-utils: open a private browser window when adding a subscription account
	optdepends = ripgrep: scan pi and omp sessions for usage records
	optdepends = github-cli: Copilot usage through the gh login
	optdepends = ollama: run local models for your agents
	optdepends = ollama-cuda: GPU acceleration for local models on NVIDIA
	optdepends = ollama-rocm: GPU acceleration for local models on AMD
	optdepends = paru: install AUR-packaged agents
	optdepends = git: update Git checkouts and check reviewed CachyOS upstreams
	provides = cachyos-agent-system
	conflicts = cachyos-agent-system
	replaces = cachyos-agent-system
	source = cachyos-agent::git+https://github.com/keiranhaax/CachyOS-Agent.git#tag=v0.2.0
	b2sums = SKIP

pkgname = cachyos-agent
