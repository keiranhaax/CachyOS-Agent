#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# Adapted from Omarchy bin/omarchy-agent-account-rename (MIT, Copyright (c) David Heinemeier Hansson); see THIRD_PARTY_NOTICES.md
# cachyos-agent:summary=Rename a Claude, Codex, or Grok subscription account
# cachyos-agent:args=[claude|codex|grok] <account> <name>
# cachyos-agent:examples=cachyos-agent account rename primary Home | cachyos-agent account rename codex side Side project
set -euo pipefail

# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"
# shellcheck source=../lib/accounts.sh
source "$CACHYOS_AGENT_ROOT/lib/accounts.sh"

usage() {
  cat <<'EOF'
Usage: cachyos-agent account rename [claude|codex|grok] <account> <name>

Give an account a new name. Its id, the word the other account commands take,
follows the name; "primary" always means the login in ~/.claude, ~/.codex or
~/.grok. The provider can be left out when it is your default agent.
EOF
}

case ${1-} in
  -h | --help)
    usage
    exit 0
    ;;
esac
acct_args "$@"
set -- "${ACCT_ARGS[@]}"
if ! acct_provider "${1-}" || (($# < 3)); then
  usage >&2
  exit 1
fi
provider=$1

account=$(cachyos-agent-account-state rename "$@")
echo "Renamed to $(jq -r .label <<<"$account"). Switch to it with: cachyos-agent account use $provider $(jq -r .id <<<"$account")"
# The usage record names the accounts.
acct_usage_refresh --limits-only "$provider"
