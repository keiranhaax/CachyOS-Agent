#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# cachyos-agent:summary=Re-sync the agent themes whenever the Plasma color scheme changes
# cachyos-agent:args=[on|off|status]
# cachyos-agent:examples=cachyos-agent theme follow on | cachyos-agent theme follow status
# A user path unit watches kdeglobals and starts a service that runs
# cachyos-agent-theme-sync. Plasma rewrites kdeglobals for many reasons; the sync
# publishes only what changed, so a spurious run costs a few milliseconds.
set -euo pipefail

# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

PATH_UNIT=cachyos-agent-theme-sync.path
UNITS=("$PATH_UNIT" cachyos-agent-theme-sync.service)
# Where the package installs the units; a checkout has none there. The variable
# exists so tests can stand in for either case.
SYSTEM_UNIT_DIR=${CACHYOS_AGENT_SYSTEM_UNIT_DIR:-/usr/lib/systemd/user}
USER_UNIT_DIR=${XDG_CONFIG_HOME:-${HOME:?HOME is not set}/.config}/systemd/user
MARKER='# Generated by cachyos-agent theme follow'

usage() {
  cat <<'USAGE'
Usage: cachyos-agent theme follow [on|off|status]

  on      watch the Plasma color scheme and run `cachyos-agent theme sync`
          whenever it changes (enables the user path unit
          cachyos-agent-theme-sync.path)
  off     stop watching
  status  say whether it is watching (the default)

A packaged install has the units under /usr/lib/systemd/user. From a checkout
they are generated into ~/.config/systemd/user, pointing at the checkout, and
removed again by `off`. The watcher syncs without --activate: it keeps the
cachyos theme current in agents that already use it, and switches none to it.
USAGE
}

installed_by_package() {
  local unit
  for unit in "${UNITS[@]}"; do
    [[ -f $SYSTEM_UNIT_DIR/$unit ]] || return 1
  done
}

# A unit this command generated, as opposed to one that someone wrote or that a
# dotfiles manager links in, which is theirs to keep.
is_generated() {
  [[ -f $1 && ! -L $1 && $(head -n 1 -- "$1") == "$MARKER"* ]]
}

# Copies of the shipped units whose /usr/bin/ is this checkout's bin directory.
# The path ends up in an ExecStart= line, where systemd reads % and $ and
# spaces specially, so a checkout whose path holds any of them is refused
# instead of escaped.
generate_units() {
  local unit content file
  [[ $CACHYOS_AGENT_BIN =~ ^[A-Za-z0-9/._+-]+$ ]] \
    || ca_die "cannot generate units for a checkout at $CACHYOS_AGENT_ROOT: its path needs escaping in a unit file"
  for unit in "${UNITS[@]}"; do
    file=$USER_UNIT_DIR/$unit
    if [[ -e $file ]] && ! is_generated "$file"; then
      ca_die "$file exists and was not generated by this command; remove it or enable it yourself"
    fi
  done
  for unit in "${UNITS[@]}"; do
    content=$(<"$CACHYOS_AGENT_ROOT/systemd/user/$unit")
    printf '%s from %s; removed by: cachyos-agent theme follow off\n%s\n' \
      "$MARKER" "$CACHYOS_AGENT_ROOT" "${content//\/usr\/bin\//$CACHYOS_AGENT_BIN/}" |
      ca_atomic_write "$USER_UNIT_DIR/$unit"
  done
}

remove_generated_units() {
  local unit
  for unit in "${UNITS[@]}"; do
    if is_generated "$USER_UNIT_DIR/$unit"; then
      rm -f -- "$USER_UNIT_DIR/$unit"
    fi
  done
}

follow_on() {
  if installed_by_package; then
    remove_generated_units # an old checkout's copy would shadow the packaged unit
  else
    generate_units
  fi
  systemctl --user daemon-reload
  systemctl --user enable --now "$PATH_UNIT"
  echo "theme follow: on (run 'cachyos-agent theme sync' to bring the agents up to date now)"
}

follow_off() {
  if systemctl --user cat "$PATH_UNIT" >/dev/null 2>&1; then
    systemctl --user disable --now "$PATH_UNIT"
  fi
  remove_generated_units
  systemctl --user daemon-reload
  echo "theme follow: off"
}

follow_status() {
  local enabled active
  enabled=$(systemctl --user is-enabled "$PATH_UNIT" 2>/dev/null) || true
  active=$(systemctl --user is-active "$PATH_UNIT" 2>/dev/null) || true
  if [[ $enabled == enabled && $active == active ]]; then
    echo "theme follow: on ($enabled, $active)"
  else
    echo "theme follow: off (${enabled:-not installed}, ${active:-inactive})"
  fi
}

if (($# > 1)); then
  usage >&2
  exit 2
fi
case ${1-status} in
  on | off | status)
    ca_cmd_present systemctl || ca_die "systemctl not found"
    "follow_${1-status}"
    ;;
  -h | --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
