#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# cachyos-agent:summary=Refresh the usage records every 15 minutes with a systemd user timer
# cachyos-agent:args=[on|off|status]
# cachyos-agent:examples=cachyos-agent usage schedule on | cachyos-agent usage schedule status
set -euo pipefail

# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

SERVICE=cachyos-agent-usage-update.service
TIMER=cachyos-agent-usage-update.timer
# Where the units sit in a Git checkout. The package does not install this
# directory: it puts the units in /usr/lib/systemd/user instead.
CHECKOUT_UNITS=$CACHYOS_AGENT_ROOT/systemd/user
USER_UNITS=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
MARKER='# Generated by cachyos-agent usage schedule'

usage() {
  cat <<'EOF'
Usage: cachyos-agent usage schedule [on|off|status]

on      enable and start the timer that runs `cachyos-agent usage update`
        every 15 minutes (2 minutes after boot for the first run)
off     stop and disable it
status  print whether it is enabled and active (the default)

Run from a Git checkout, `on` writes the units into ~/.config/systemd/user
with ExecStart pointing at the checkout; `off` removes them again.
EOF
}

# A path inside ExecStart= is split on spaces and has $ and % expanded, so
# quote it and double what systemd would otherwise read as syntax.
exec_quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//%/%%}
  s=${s//\$/\$\$}
  printf '"%s"' "$s"
}

is_generated() {
  local first=''
  if [[ -f $1 ]]; then IFS= read -r first <"$1" || true; fi
  [[ $first == "$MARKER"* ]]
}

# render <unit>: the shipped unit, with ExecStart pointing at this checkout.
render() {
  local line
  printf '%s from %s\n' "$MARKER" "$CACHYOS_AGENT_ROOT"
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == ExecStart=* ]]; then
      printf 'ExecStart=%s\n' "$(exec_quote "$CACHYOS_AGENT_BIN/cachyos-agent-usage-update")"
    else
      printf '%s\n' "$line"
    fi
  done <"$CHECKOUT_UNITS/$1"
}

install_checkout_units() {
  local unit target rendered
  for unit in "$SERVICE" "$TIMER"; do
    target=$USER_UNITS/$unit
    if [[ -e $target ]] && ! is_generated "$target"; then
      ca_die "$target already exists and was not written by this command; move it aside first"
    fi
  done
  for unit in "$SERVICE" "$TIMER"; do
    rendered=$(render "$unit")
    printf '%s\n' "$rendered" | ca_atomic_write "$USER_UNITS/$unit"
  done
  systemctl --user daemon-reload
}

remove_checkout_units() {
  local unit removed=false
  for unit in "$SERVICE" "$TIMER"; do
    if is_generated "$USER_UNITS/$unit"; then
      rm -f -- "$USER_UNITS/$unit"
      removed=true
    fi
  done
  if $removed; then systemctl --user daemon-reload; fi
}

schedule_on() {
  if [[ -f $CHECKOUT_UNITS/$TIMER ]]; then
    install_checkout_units
  fi
  systemctl --user enable --now "$TIMER"
}

schedule_off() {
  systemctl --user disable --now "$TIMER"
  remove_checkout_units
}

# systemctl exits nonzero for every state but the good one and still prints the
# state, so the exit status is ignored and the word is what counts.
schedule_status() {
  local enabled active
  enabled=$(systemctl --user is-enabled "$TIMER" 2>/dev/null) || true
  active=$(systemctl --user is-active "$TIMER" 2>/dev/null) || true
  printf '%s, %s\n' "${enabled:-unknown}" "${active:-unknown}"
}

main() {
  local action=${1-status}
  case $action in
    -h | --help) usage ;;
    on | off | status)
      ca_cmd_present systemctl || ca_die "systemctl not found"
      "schedule_$action"
      ;;
    *) ca_die "unknown action: $action (use on, off or status)" ;;
  esac
}

main "$@"
