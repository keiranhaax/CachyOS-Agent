#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# Adapted from Omarchy bin/omarchy-agent-account-mode (MIT, Copyright (c) David Heinemeier Hansson); see THIRD_PARTY_NOTICES.md
# cachyos-agent:summary=Switch Claude, Codex, or Grok accounts automatically near a limit, or only notify
# cachyos-agent:args=[claude|codex|grok] [auto|notify] [threshold]
# cachyos-agent:examples=cachyos-agent account mode auto | cachyos-agent account mode auto 90 | cachyos-agent account mode codex notify
set -euo pipefail

# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"
# shellcheck source=../lib/accounts.sh
source "$CACHYOS_AGENT_ROOT/lib/accounts.sh"

usage() {
  cat <<'EOF'
Usage: cachyos-agent account mode [claude|codex|grok] [auto|notify] [threshold]

With auto, new sessions switch by themselves to the account with the most
headroom when the active one passes the threshold. With notify (the default),
you get a notification instead and switch when you say so. The threshold is a
percentage from 50 to 100 and defaults to 95. Without a mode, show the current
setting. The provider can be left out when it is your default agent.
EOF
}

case ${1-} in
  -h | --help)
    usage
    exit 0
    ;;
esac
acct_args "$@"
set -- "${ACCT_ARGS[@]}"
if ! acct_provider "${1-}" || (($# > 3)); then
  usage >&2
  exit 1
fi
provider=$1

if [[ -n ${2-} ]]; then
  # The registry's own word for notifying is "manual", which the usage
  # collectors read, so notify is accepted here and stored as that.
  mode=$2
  if [[ $mode == notify ]]; then
    mode=manual
  fi
  cachyos-agent-account-state mode "$provider" "$mode" ${3:+"$3"}
fi

cachyos-agent-account-state registry "$provider" | jq -r '
  if .switch == "auto" then
    "\(.name) switches new sessions to the account with the most headroom at \(.threshold)%."
  else
    "\(.name) notifies at \(.threshold)% and switches when you say so."
  end'
