#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# cachyos-agent:summary=Compare reviewed CachyOS upstream commits with the current branch heads
# cachyos-agent:args=[ROOT]
# cachyos-agent:examples=cachyos-agent skills check-upstreams
# Compare reviewed upstream commits with the current official branch heads.
# Rows may scope the comparison to the paths the guidance actually relies on.
set -euo pipefail

# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

usage() {
  cat <<'USAGE'
Usage: cachyos-agent skills check-upstreams [ROOT]

Read ROOT/upstreams.tsv and compare each reviewed commit with the current
official branch head. ROOT defaults to the data root of this installation: the
checkout containing this script, or /usr/share/cachyos-agent when packaged.

A row may carry a fifth column of space-separated paths. When the branch head
moved but no commit in the reviewed range touches those paths, the row is
reported as current-in-scope instead of requiring review. Scoped rows need a
network Git fetch (blob-less, commits and trees only); when that fetch fails,
the row conservatively requires review.

Exit status:
  0  all reviewed commits are current (in scope, where scoped)
  1  one or more upstreams changed and require review
  2  the check could not be completed
USAGE
}

if (( $# > 1 )); then
  usage >&2
  exit 2
fi
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  usage
  exit 0
fi

ROOT=$(cd -- "${1:-$CACHYOS_AGENT_ROOT}" 2>/dev/null && pwd) || {
  echo "not a directory: ${1:-$CACHYOS_AGENT_ROOT}" >&2
  exit 2
}
manifest="$ROOT/upstreams.tsv"

if [[ ! -r "$manifest" ]]; then
  echo "cannot read upstream manifest: $manifest" >&2
  exit 2
fi
if ! command -v git >/dev/null 2>&1; then
  echo "git is required to query official upstream branches" >&2
  exit 2
fi

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

# Count commits in reviewed..current that touch the given paths.
# Prints the count on success; returns nonzero when it cannot be determined.
scoped_change_count() {
  local url=$1 ref=$2 reviewed=$3 current=$4
  shift 4
  local clone="$WORKDIR/scope-repo" count
  rm -rf "$clone"
  git init --quiet --bare "$clone"
  if ! git -C "$clone" fetch --quiet --filter=blob:none "$url" "$ref" "$reviewed" 2>/dev/null; then
    return 1
  fi
  if ! count=$(git -C "$clone" rev-list --count "$reviewed..$current" -- "$@" 2>/dev/null); then
    return 1
  fi
  printf '%s\n' "$count"
}

changed=0
checked=0
while IFS=$'\t' read -r name url ref reviewed paths; do
  [[ -z "$name" || $name == \#* ]] && continue
  if [[ -z "$url" || -z "$ref" || ! "$reviewed" =~ ^[0-9a-f]{40}$ ]]; then
    echo "invalid row in $manifest: $name" >&2
    exit 2
  fi
  if ! result=$(git ls-remote "$url" "$ref"); then
    echo "failed to query $name ($url $ref)" >&2
    exit 2
  fi
  current=${result%%[[:space:]]*}
  if [[ ! "$current" =~ ^[0-9a-f]{40}$ ]]; then
    echo "no branch head returned for $name ($ref)" >&2
    exit 2
  fi
  ((checked++)) || true
  if [[ "$current" == "$reviewed" ]]; then
    echo "current: $name ${current:0:12}"
    continue
  fi
  if [[ -n "${paths:-}" ]]; then
    # shellcheck disable=SC2086
    if count=$(scoped_change_count "$url" "$ref" "$reviewed" "$current" $paths); then
      if (( count == 0 )); then
        echo "current in scope: $name head moved ${reviewed:0:12} -> ${current:0:12}; no changes under: $paths"
        continue
      fi
      echo "review required: $name ${reviewed:0:12} -> ${current:0:12} ($count in-scope commit(s) under: $paths)"
    else
      echo "review required: $name ${reviewed:0:12} -> ${current:0:12} (scoped fetch failed; treating as changed)"
    fi
  else
    echo "review required: $name ${reviewed:0:12} -> ${current:0:12}"
  fi
  ((changed++)) || true
done < "$manifest"

if (( checked == 0 )); then
  echo "no upstream entries found in $manifest" >&2
  exit 2
fi
if (( changed > 0 )); then
  echo "$changed of $checked upstream branch(es) changed in scope; review before updating upstreams.tsv" >&2
  exit 1
fi
echo "all $checked reviewed upstream branch(es) are current"
