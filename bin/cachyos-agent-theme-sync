#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# Adapted from Omarchy bin/omarchy-theme-set-claude, omarchy-theme-set-hermes and omarchy-theme-set-pi (MIT, Copyright (c) David Heinemeier Hansson); see THIRD_PARTY_NOTICES.md
# cachyos-agent:summary=Sync the Plasma color scheme into Hermes, Claude Code, Pi and OpenCode
# cachyos-agent:args=[--activate] [--only hermes,claude,pi,opencode]
# cachyos-agent:examples=cachyos-agent theme sync | cachyos-agent theme sync --activate --only claude,hermes
# Renders the agent templates in data/themed/ with the palette of the active
# Plasma color scheme into $CACHYOS_AGENT_STATE_DIR/theme/, then publishes each
# result to its agent as a theme named "cachyos". Publishing again changes
# nothing and touches nothing, so a watcher can run this on every kdeglobals write.
set -euo pipefail

# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"
# shellcheck source=../lib/theme.sh
source "$CACHYOS_AGENT_ROOT/lib/theme.sh"

THEME_NAME=cachyos
THEME_DIR=$CACHYOS_AGENT_STATE_DIR/theme
# Target -> the rendered file, which is also the template's name without .tpl.
declare -A RENDERED_FILE=([hermes]=hermes.yaml [claude]=claude.json [pi]=pi.json [opencode]=opencode.json)
ORDER=(hermes claude pi opencode)
ACTIVATE=0

usage() {
  cat <<'USAGE'
Usage: cachyos-agent theme sync [--activate] [--only hermes,claude,pi,opencode]

Render the Plasma color scheme into a "cachyos" theme for each agent and
publish it. Without --activate only agents whose config directory exists get
the theme, and no agent switches to it, so a theme the agent's user chose
stays. --activate creates the directories and makes cachyos the agent's theme.

  hermes    $HERMES_HOME/skins and every profile's skins/ (needs a config.yaml,
            i.e. Hermes has run); --activate runs: hermes skin use cachyos
  claude    $CLAUDE_CONFIG_DIR/themes/cachyos.json; --activate sets theme to
            custom:cachyos in settings.json. Running sessions reload the file,
            except that a themes/ folder created after Claude Code started
            needs one restart.
  pi        ~/.pi/agent/themes/cachyos.json; --activate sets theme in settings.json
  opencode  ~/.config/opencode/themes/cachyos.json; --activate sets theme in
            tui.json. A running OpenCode picks the colors up on restart.

Rendered files are kept in $XDG_STATE_HOME/cachyos-agent/theme/.
USAGE
}

targets=("${ORDER[@]}")
while (($# > 0)); do
  case $1 in
    --activate)
      ACTIVATE=1
      shift
      ;;
    --only)
      (($# >= 2)) || { usage >&2; exit 2; }
      IFS=, read -ra targets <<<"$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done
((${#targets[@]} > 0)) || { usage >&2; exit 2; }
for target in "${targets[@]}"; do
  [[ -n $target && -n ${RENDERED_FILE[$target]-} ]] || { echo "unknown target: $target" >&2; usage >&2; exit 2; }
done
ca_cmd_present jq || ca_die "jq not found"

# Hermes parses the skin as YAML and hands its strings to every surface, so only
# the name, a plain description and #rrggbb colors may reach it, in the order
# YAML needs them. YAML breaks lines on bytes grep does not, so the bytes are
# counted first, NUL included.
skin_is_well_formed() {
  local skin=$1
  (($(printf '%s\n' "$skin" | LC_ALL=C tr -d ' -~\n' | wc -c) == 0)) &&
    printf '%s\n' "$skin" | awk -v name="name: $THEME_NAME" '
      bad { next }
      /^#/ || /^[[:space:]]*$/ { next }
      !seen_name { if ($0 == name) seen_name = 1; else bad = 1; next }
      !seen_colors {
        if ($0 == "colors:") seen_colors = 1
        else if (!seen_description && $0 ~ /^description: [A-Za-z0-9 ,.()-]{0,200}$/) seen_description = 1
        else bad = 1
        next
      }
      /^  [a-z_]{1,64}: "#[0-9a-fA-F]{6}"$/ { colors++; next }
      { bad = 1 }
      END { exit (bad || !seen_colors || colors == 0) }
    '
}

# render <file>: expand data/themed/<file>.tpl into the state directory, but only
# once the result is something its agent will accept: JSON that parses, or a
# skin that passes the check above. What is checked is what gets written.
render() {
  local file=$1 data
  data=$(theme_render "$THEME_DIR/palette.tsv" <"$CACHYOS_AGENT_ROOT/data/themed/$file.tpl") || return 1
  case $file in
    *.json) jq -e . >/dev/null <<<"$data" || { echo "$file: rendered JSON does not parse" >&2; return 1; } ;;
    hermes.yaml) skin_is_well_formed "$data" || { echo "$file: rendered skin is not a plain color palette" >&2; return 1; } ;;
  esac
  printf '%s\n' "$data" | ca_atomic_write "$THEME_DIR/$file"
}

# Functions below run in an || list, where set -e is off, so they check their steps.

# publish <agent> <rendered-file> <destination>: replace the destination with
# the rendered file unless it already holds it. An agent that watches the file
# repaints on every write, so an identical one is left alone.
publish() {
  local agent=$1 source=$THEME_DIR/$2 dest=$3
  if [[ -d $dest ]]; then
    echo "$agent: $dest is a directory" >&2
    return 1
  fi
  if [[ -f $dest ]] && cmp -s -- "$source" "$dest"; then
    echo "$agent: unchanged $dest"
  elif ca_atomic_write "$dest" <"$source"; then
    echo "$agent: wrote $dest"
  else
    echo "$agent: could not write $dest" >&2
    return 1
  fi
}

# set_setting <agent> <json-file> <key> <value>: set one top-level string in an
# agent's settings, keeping every other key. A file that is not a JSON object is
# left as it was. That includes one holding only whitespace or null: jq prints
# nothing for the first and would swap an object in for the second, either way
# a file that is not what the agent wrote and may be mid-write.
set_setting() {
  local agent=$1 file=$2 key=$3 value=$4 data
  local -a args=(--arg key "$key" --arg value "$value")
  if [[ -s $file ]]; then
    if jq -e "${args[@]}" '.[$key] == $value' "$file" >/dev/null 2>&1; then
      echo "$agent: unchanged $file"
      return 0
    fi
    data=$(jq -e "${args[@]}" 'if type == "object" then .[$key] = $value else empty end' "$file")
  else
    data=$(jq -n "${args[@]}" '{($key): $value}')
  fi || { echo "$agent: cannot update $file; left as it was" >&2; return 1; }
  printf '%s\n' "$data" | ca_atomic_write "$file" || return 1
  echo "$agent: set $key to $value in $file"
}

# present <agent> <config-dir>: publish only to an agent that is there, unless
# --activate asked for the theme to be made regardless.
present() {
  if ((ACTIVATE == 1)) || [[ -d $2 ]]; then
    return 0
  fi
  echo "$1: skipped, $2 does not exist"
  return 1
}

# The gateway reads a skin whole on an mtime change, which is why publish
# replaces it atomically. A profile is a Hermes home of its own; existing ones
# get the skin, none are made, and one that cannot take it does not cost the
# others. The config.yaml is what Hermes writes once it has run: the skills
# provisioner creates $HERMES_HOME for every machine, so the directory alone
# proves nothing.
sync_hermes() {
  local home=${HERMES_HOME:-$HOME/.hermes} profile status=0
  if [[ ! -f $home/config.yaml ]]; then
    echo "hermes: skipped, $home/config.yaml not found; launch Hermes once first"
    return 0
  fi
  publish hermes hermes.yaml "$home/skins/$THEME_NAME.yaml" || return 1
  for profile in "$home"/profiles/*/; do
    [[ -d $profile ]] || continue
    publish hermes hermes.yaml "${profile%/}/skins/$THEME_NAME.yaml" || status=1
  done
  ((ACTIVATE == 1)) || return "$status"
  # Hermes' own writer: it updates the active profile's config and touches the
  # skin so a running gateway repaints.
  if ! ca_cmd_present hermes; then
    echo "hermes: cannot activate, hermes is not on PATH" >&2
    return 1
  fi
  timeout 30 hermes skin use "$THEME_NAME" || {
    echo "hermes: 'hermes skin use $THEME_NAME' failed" >&2
    return 1
  }
  return "$status"
}

# Claude Code watches ~/.claude/themes and reloads the file on change, so
# running sessions retint without a restart (unless the folder itself did not
# exist when the session started).
sync_claude() {
  local dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  present claude "$dir" || return 0
  publish claude claude.json "$dir/themes/$THEME_NAME.json" || return 1
  ((ACTIVATE == 0)) || set_setting claude "$dir/settings.json" theme "custom:$THEME_NAME"
}

# Pi hot-reloads the active theme from <agent-dir>/themes/<name>.json.
sync_pi() {
  local dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
  present pi "$dir" || return 0
  publish pi pi.json "$dir/themes/$THEME_NAME.json" || return 1
  ((ACTIVATE == 0)) || set_setting pi "$dir/settings.json" theme "$THEME_NAME"
}

# OpenCode reads themes/*.json from its config directory and the chosen theme
# from tui.json. A tui.jsonc may hold comments that jq would drop, so with one
# present the choice stays with the user. Omarchy's omarchy-restart-opencode
# sends SIGUSR2 to reload a running OpenCode; the current docs do not promise a
# handler, and a process without one is terminated by that signal, so none is sent.
sync_opencode() {
  local dir=${XDG_CONFIG_HOME:-$HOME/.config}/opencode
  present opencode "$dir" || return 0
  publish opencode opencode.json "$dir/themes/$THEME_NAME.json" || return 1
  ((ACTIVATE == 1)) || return 0
  if [[ -e $dir/tui.jsonc ]]; then
    echo "opencode: not editing $dir/tui.jsonc; choose $THEME_NAME with /theme"
    return 0
  fi
  set_setting opencode "$dir/tui.json" theme "$THEME_NAME"
}

mkdir -p "$THEME_DIR"
# Palette first and in full: the palette command says why when it fails.
palette=$(cachyos-agent-theme-palette) || exit 1
printf '%s\n' "$palette" | ca_atomic_write "$THEME_DIR/palette.tsv"

failed=()
for target in "${targets[@]}"; do
  if render "${RENDERED_FILE[$target]}" && "sync_$target"; then
    continue
  fi
  failed+=("$target")
done
if ((${#failed[@]} > 0)); then
  echo "theme sync failed for: ${failed[*]}" >&2
  exit 1
fi
