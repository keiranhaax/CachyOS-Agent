#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# Adapted from Omarchy bin/omarchy-toggle-crash-capture (MIT, Copyright (c) David Heinemeier Hansson); see THIRD_PARTY_NOTICES.md
# cachyos-agent:summary=Turn the crash watcher on or off, or show whether it runs
# cachyos-agent:args=[on|off|status]
# cachyos-agent:examples=cachyos-agent crash capture status | cachyos-agent crash capture on | cachyos-agent crash capture off
set -euo pipefail

# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

readonly UNIT=cachyos-agent-crash-watch.service
# Where the package installs the unit. Tests point it elsewhere.
readonly PACKAGED_UNIT=${CACHYOS_AGENT_SYSTEMD_USER_DIR:-/usr/lib/systemd/user}/$UNIT
readonly SHIPPED_UNIT=$CACHYOS_AGENT_ROOT/systemd/user/$UNIT
readonly CHECKOUT_UNIT=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT
readonly GENERATED_MARK='# Generated by cachyos-agent crash capture from a Git checkout; delete it to use the packaged unit.'

usage() {
  cat <<'USAGE'
Usage: cachyos-agent crash capture [on|off|status]

Crash capture runs a user service that watches systemd-coredump and offers a
notification when one of your programs crashes. Choosing it hands the crash to
your default agent (cachyos-agent crash). Without an argument, show the status.

  on       enable the service for every login and start it now
  off      disable it and stop it
  status   print whether it is enabled and whether it is running

Silence one program instead with: cachyos-agent crash mute <program>
USAGE
}

# The ExecStart= line for a script. The quotes keep a space in a path inside one
# word, and % would start a specifier, so it is doubled. The executable is never
# expanded as a variable, unlike an argument, so a $ stays as it is. systemd
# refuses quotes, backslashes and control characters in the executable
# whatever escaping they get, so say so here rather than write a unit it will
# not load.
exec_start() {
  case $1 in
    *\"* | *\'* | *\\* | *[[:cntrl:]]*)
      ca_die "cannot run the watcher from $1: systemd refuses quotes, backslashes and control characters in an ExecStart path"
      ;;
  esac
  printf 'ExecStart="%s"\n' "${1//%/%%}"
}

# A Git checkout has no unit in /usr/lib: make one for this user from the shipped
# unit, run from the checkout's own script.
generate_unit() {
  local line unit
  [[ -r $SHIPPED_UNIT ]] || ca_die "cannot read $SHIPPED_UNIT"
  unit=$(
    printf '%s\n' "$GENERATED_MARK"
    while IFS= read -r line; do
      if [[ $line == ExecStart=* ]]; then
        exec_start "$CACHYOS_AGENT_BIN/cachyos-agent-crash-watch"
      else
        printf '%s\n' "$line"
      fi
    done <"$SHIPPED_UNIT"
  )
  printf '%s\n' "$unit" | ca_atomic_write "$CHECKOUT_UNIT"
}

# A unit in the config directory shadows the one in /usr/lib, so a copy this
# command generated before the package was installed must go, or it would keep
# running a checkout that may no longer exist. Only a file that carries the mark
# is ours to remove.
retire_generated_unit() {
  if [[ -f $CHECKOUT_UNIT ]] && grep -qxF -- "$GENERATED_MARK" "$CHECKOUT_UNIT"; then
    systemctl --user disable --now "$UNIT"
    rm -f -- "$CHECKOUT_UNIT"
  fi
}

capture_on() {
  ca_cmd_present notify-send || ca_die "notify-send not found: install libnotify, then run this again"
  if [[ -f $PACKAGED_UNIT ]]; then
    retire_generated_unit
  else
    generate_unit
  fi
  systemctl --user enable --now "$UNIT"
  echo "Crash capture is on."
  # The watcher announces nothing until an agent is chosen; say so now, while
  # the user is looking, rather than leave them waiting for a toast.
  if ca_cmd_present cachyos-agent-default && [[ -z $(cachyos-agent-default) ]]; then
    echo "No default agent is set, so crashes are not announced yet: run 'cachyos-agent default <name>'."
  fi
}

# Nothing to disable when the unit was never installed, and off still holds.
capture_off() {
  if systemctl --user cat "$UNIT" >/dev/null 2>&1; then
    systemctl --user disable --now "$UNIT"
  fi
  echo "Crash capture is off."
}

capture_status() {
  local enabled=no active=no
  if systemctl --user is-enabled --quiet "$UNIT" 2>/dev/null; then enabled=yes; fi
  if systemctl --user is-active --quiet "$UNIT" 2>/dev/null; then active=yes; fi
  printf 'enabled: %s\nactive: %s\n' "$enabled" "$active"
}

if (($# > 1)); then
  usage >&2
  exit 1
fi
case ${1-status} in
  on) capture_on ;;
  off) capture_off ;;
  status) capture_status ;;
  -h | --help) usage ;;
  *)
    echo "Not an action: $1" >&2
    usage >&2
    exit 1
    ;;
esac
